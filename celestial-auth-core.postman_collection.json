        {
            "name": "Auth - Email",
            "item": [
                {
                    "name": "POST /auth/email/login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Basic smoke tests for login",
                                    "pm.test(\"Status code is 200 or 401\", function () {",
                                    "  pm.expect([200, 401]).to.include(pm.response.code);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "  pm.test(\"Access token is present\", function () {",
                                    "    var json = pm.response.json();",
                                    "    pm.expect(json).to.have.property('accessToken');",
                                    "    pm.expect(json).to.have.property('user');",
                                    "    pm.expect(json.user).to.have.property('email');",
                                    "  });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/email/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "email",
                                "login"
                            ]
                        },
                        "description": "Email/password login.\n\n200: returns accessToken + user.\n400: missing email or password.\n401: invalid credentials."
                    },
                    "response": [
                        {
                            "name": "Sample 200",
                            "originalRequest": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/auth/email/login",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "auth",
                                        "email",
                                        "login"
                                    ]
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "body": "{\n  \"accessToken\": \"<jwt>\",\n  \"user\": {\n    \"id\": \"user-1\",\n    \"email\": \"test@example.com\",\n    \"tenantId\": \"tenant-1\",\n    \"tenantSlug\": \"example-tenant\"\n  }\n}"
                        },
                        {
                            "name": "Sample 400 - Missing fields",
                            "originalRequest": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
