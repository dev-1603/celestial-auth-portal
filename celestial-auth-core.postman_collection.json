                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"email\": \"test@example.com\"\n}"
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/auth/email/login",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "auth",
                                        "email",
                                        "login"
                                    ]
                                }
                            },
                            "status": "Bad Request",
                            "code": 400,
                            "body": "{\n  \"error\": \"Email and password are required\"\n}"
                        },
                        {
                            "name": "Sample 401 - Invalid credentials",
                            "originalRequest": {
                                "method": "POST",
