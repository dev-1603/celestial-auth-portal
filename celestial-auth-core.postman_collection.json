                {
                    "name": "POST /auth/email/logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "  pm.expect(pm.response.code).to.equal(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Success flag is true\", function () {",
                                    "  var json = pm.response.json();",
                                    "  pm.expect(json).to.have.property('success', true);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/email/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "email",
                                "logout"
                            ]
                        },
                        "description": "Logout.\nClears the refresh token cookie and returns { success: true }."
                    },
                    "response": [
