PORT=
NODE_ENV=                           # development | production | test

# Supabase / Database
DATABASE_URL=                       # pooler connection (port 6543) — used by Prisma
DIRECT_URL=                         # direct connection (port 5432) — used for  migrations
SUPABASE_URL=                       # https://[project-ref].supabase.co
SUPABASE_ANON_KEY=                  # from Supabase dashboard → API settings

# JWT
JWT_SECRET=                         # legacy — keep until fully migrated
JWT_ACCESS_SECRET=                  # min 32 chars
JWT_REFRESH_SECRET=                 # min 32 chars, different from access
JWT_ACCESS_EXPIRY=                  # default: 15m
JWT_REFRESH_EXPIRY=                 # default: 7d

# CORS
ALLOWED_ORIGINS=                    # comma separated

# Deployment
DEPLOYMENT_MODE=                    # standalone | saas
AUTH_MODE=                          # internal | external

# Email
SMTP_HOST=
SMTP_PORT=                          # 587 | 465
SMTP_USER=
SMTP_PASS=                          # app password
SMTP_FROM=

# Security
BCRYPT_ROUNDS=                      # default: 10
AUTH_CODE_EXPIRY_MINS=              # default: 5
CLIENT_SECRET_SALT_ROUNDS=          # default: 10
