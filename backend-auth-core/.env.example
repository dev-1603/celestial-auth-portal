PORT=
NODE_ENV=                           # development | production | test
API_URL=                             # https://api.celestial.com    

# Supabase / Database
DB_DIALECT=                          # postgres | supabase
# For Supabase: use Connection string from Dashboard → Settings → Database.
# Pooler (port 6543): username MUST be postgres.[project-ref], not "postgres".
#   Example: postgresql://postgres.abcdefghijklmnop:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=                        # pooler (port 6543) for app
# For migrations: MUST use direct connection. Using pooler host (e.g. pooler.supabase.com:5432) causes "Tenant or user not found".
DIRECT_URL=                          # direct: postgresql://postgres:PASSWORD@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=                        # https://[project-ref].supabase.co
SUPABASE_ANON_KEY=                   # from Supabase dashboard → API settings

# JWT
JWT_SECRET=                         # legacy — keep until fully migrated
JWT_ACCESS_SECRET=                  # min 32 chars
JWT_REFRESH_SECRET=                 # min 32 chars, different from access
JWT_ACCESS_EXPIRY=                  # default: 15m
JWT_REFRESH_EXPIRY=                 # default: 7d

# CORS
ALLOWED_ORIGINS=                    # comma separated

# Deployment
DEPLOYMENT_MODE=                    # standalone | saas
AUTH_MODE=                          # internal | external

# Email
EMAIL_PROVIDER=                     # nodemailer (default, free SMTP) | sendgrid (paid) | console (dev only)
SMTP_HOST=                          # smtp.gmail.com, smtp-mail.outlook.com, or custom SMTP
SMTP_PORT=                          # 587 (TLS) | 465 (SSL)
SMTP_USER=                          # SMTP username
SMTP_PASS=                          # SMTP password or app password (for Gmail)
SMTP_FROM=                          # From email address (defaults to SMTP_USER)
# SENDGRID_API_KEY=                # Required if EMAIL_PROVIDER=sendgrid

# SMS (for Phone OTP)
SMS_PROVIDER=                     # console (default, dev only) | twilio (production, paid)
TWILIO_ACCOUNT_SID=               # Required if SMS_PROVIDER=twilio
TWILIO_AUTH_TOKEN=                # Required if SMS_PROVIDER=twilio
TWILIO_FROM_NUMBER=               # Twilio phone number (E.164 format, e.g., +1234567890)

# OAuth (for OAuth providers)
# Google
OAUTH_GOOGLE_CLIENT_ID=           # Required for Google OAuth
OAUTH_GOOGLE_CLIENT_SECRET=       # Required for Google OAuth
# GitHub
OAUTH_GITHUB_CLIENT_ID=           # Required for GitHub OAuth
OAUTH_GITHUB_CLIENT_SECRET=       # Required for GitHub OAuth
# Microsoft
OAUTH_MICROSOFT_CLIENT_ID=        # Required for Microsoft OAuth
OAUTH_MICROSOFT_CLIENT_SECRET=    # Required for Microsoft OAuth
# Facebook
OAUTH_FACEBOOK_CLIENT_ID=         # Required for Facebook OAuth
OAUTH_FACEBOOK_CLIENT_SECRET=     # Required for Facebook OAuth
# Twitter/X
OAUTH_TWITTER_CLIENT_ID=          # Required for Twitter OAuth
OAUTH_TWITTER_CLIENT_SECRET=      # Required for Twitter OAuth
# Apple
OAUTH_APPLE_CLIENT_ID=            # Required for Apple OAuth (Service ID)
OAUTH_APPLE_CLIENT_SECRET=        # Required for Apple OAuth (generated JWT)
OAUTH_APPLE_TEAM_ID=              # Apple Developer Team ID
OAUTH_APPLE_KEY_ID=               # Apple Key ID
OAUTH_APPLE_PRIVATE_KEY=          # Apple Private Key (PEM format)
# Discord
OAUTH_DISCORD_CLIENT_ID=          # Required for Discord OAuth
OAUTH_DISCORD_CLIENT_SECRET=      # Required for Discord OAuth
# LinkedIn
OAUTH_LINKEDIN_CLIENT_ID=         # Required for LinkedIn OAuth
OAUTH_LINKEDIN_CLIENT_SECRET=     # Required for LinkedIn OAuth
# Slack
OAUTH_SLACK_CLIENT_ID=            # Required for Slack OAuth
OAUTH_SLACK_CLIENT_SECRET=        # Required for Slack OAuth
# Spotify
OAUTH_SPOTIFY_CLIENT_ID=          # Required for Spotify OAuth
OAUTH_SPOTIFY_CLIENT_SECRET=      # Required for Spotify OAuth
# Twitch
OAUTH_TWITCH_CLIENT_ID=           # Required for Twitch OAuth
OAUTH_TWITCH_CLIENT_SECRET=       # Required for Twitch OAuth
# GitLab
OAUTH_GITLAB_CLIENT_ID=           # Required for GitLab OAuth
OAUTH_GITLAB_CLIENT_SECRET=       # Required for GitLab OAuth
# Bitbucket
OAUTH_BITBUCKET_CLIENT_ID=        # Required for Bitbucket OAuth
OAUTH_BITBUCKET_CLIENT_SECRET=    # Required for Bitbucket OAuth
# Dropbox
OAUTH_DROPBOX_CLIENT_ID=          # Required for Dropbox OAuth
OAUTH_DROPBOX_CLIENT_SECRET=      # Required for Dropbox OAuth
# Reddit
OAUTH_REDDIT_CLIENT_ID=           # Required for Reddit OAuth
OAUTH_REDDIT_CLIENT_SECRET=       # Required for Reddit OAuth
# Zoom
OAUTH_ZOOM_CLIENT_ID=             # Required for Zoom OAuth
OAUTH_ZOOM_CLIENT_SECRET=         # Required for Zoom OAuth

# Security
BCRYPT_ROUNDS=                      # default: 10
AUTH_CODE_EXPIRY_MINS=              # default: 5
CLIENT_SECRET_SALT_ROUNDS=          # default: 10
