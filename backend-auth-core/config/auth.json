{
  "enabledMethods": [
    "email_password",
    "email_otp",
    "magic_link",
    "phone_sms_otp",
    "oauth",
    "sso",
    "qr_login",
    "telegram",
    "whatsapp",
    "passkey"
  ],
  "defaultMethod": "email_password",
  "signupMode": "invite_only",
  "passwordPolicy": {
    "minLength": 2,
    "requireUpper": true,
    "requireLower": true,
    "requireNumber": true,
    "requireSpecial": true,
    "allowCommon": false,
    "maxAgeDays": 90,
    "historyCount": 5,
    "lockoutThreshold": 5,
    "lockoutMinutes": 15
  },
  "emailVerification": true,
  "requireVerifiedEmail": true,
  "mfa": {
    "required": false,
    "policy": "optional",
    "methods": ["totp", "sms", "webauthn"]
  },
  "methodsConfig": {
    "email_password": {
      "enabled": true,
      "allowSignup": true
    },
    "email_otp": {
      "enabled": true,
      "digits": 6,
      "expiryMinutes": 10,
      "maxAttempts": 5
    },
    "magic_link": {
      "enabled": true,
      "expiryMinutes": 20,
      "allowedDomains": []
    },
    "phone_sms_otp": {
      "enabled": true,
      "digits": 6,
      "expiryMinutes": 10,
      "maxAttempts": 5,
      "provider": "twilio",
      "fromNumber": "+19999999999"
    },
    "qr_login": {
      "enabled": true,
      "sessionExpirySeconds": 120
    },
    "telegram": {
      "enabled": false,
      "botName": ""
    },
    "whatsapp": {
      "enabled": false,
      "provider": "whatsauth"
    },
    "passkey": {
      "enabled": false,
      "userVerification": "preferred"
    }
  },
  "providers": {
    "oauth": [
      { "id": "google", "enabled": true },
      { "id": "github", "enabled": true },
      { "id": "microsoft", "enabled": true },
      { "id": "apple", "enabled": true },
      { "id": "facebook", "enabled": true },
      { "id": "twitter", "enabled": true },
      { "id": "discord", "enabled": true },
      { "id": "linkedin", "enabled": true },
      { "id": "slack", "enabled": true },
      { "id": "spotify", "enabled": true },
      { "id": "twitch", "enabled": true },
      { "id": "gitlab", "enabled": true },
      { "id": "bitbucket", "enabled": true },
      { "id": "dropbox", "enabled": true },
      { "id": "reddit", "enabled": true },
      { "id": "zoom", "enabled": true },
      { "id": "instagram", "enabled": false },
      { "id": "pinterest", "enabled": false },
      { "id": "naver", "enabled": false },
      { "id": "kakao", "enabled": false },
      { "id": "line", "enabled": false },
      { "id": "vk", "enabled": false },
      { "id": "yandex", "enabled": false },
      { "id": "notion", "enabled": false },
      { "id": "figma", "enabled": false },
      { "id": "linear", "enabled": false },
      { "id": "clickup", "enabled": false },
      { "id": "box", "enabled": false },
      { "id": "nextcloud", "enabled": false },
      { "id": "hubspot", "enabled": false },
      { "id": "pipedrive", "enabled": false },
      { "id": "salesforce", "enabled": false },
      { "id": "freshbooks", "enabled": false },
      { "id": "netsuite", "enabled": false },
      { "id": "mailchimp", "enabled": false },
      { "id": "mailgun", "enabled": false },
      { "id": "postmark", "enabled": false },
      { "id": "resend", "enabled": false },
      { "id": "mastodon", "enabled": false },
      { "id": "wordpress", "enabled": false },
      { "id": "medium", "enabled": false },
      { "id": "todoist", "enabled": false },
      { "id": "strava", "enabled": false },
      { "id": "trakt", "enabled": false }
    ],
    "sso": [
      { "id": "saml", "type": "saml", "enabled": true },
      { "id": "oidc", "type": "oidc", "enabled": true },
      { "id": "auth0", "type": "auth0", "enabled": true },
      { "id": "okta", "type": "okta", "enabled": true },
      { "id": "azure_ad", "type": "azure_ad", "enabled": false },
      { "id": "keycloak", "type": "keycloak", "enabled": false },
      { "id": "onelogin", "type": "onelogin", "enabled": false },
      { "id": "zitadel", "type": "zitadel", "enabled": false },
      { "id": "workos", "type": "workos", "enabled": false },
      { "id": "boxyhq", "type": "boxyhq", "enabled": false },
      { "id": "authentik", "type": "authentik", "enabled": false },
      { "id": "fusionauth", "type": "fusionauth", "enabled": false },
      { "id": "frontegg", "type": "frontegg", "enabled": false },
      { "id": "cognito", "type": "cognito", "enabled": false },
      { "id": "asgardio", "type": "asgardio", "enabled": false }
    ]
  },
  "rateLimits": {
    "loginAttempts": 5,
    "windowMinutesLogin": 15,
    "resetRequests": 3,
    "windowMinutesReset": 60,
    "otpRequests": 5,
    "windowMinutesOtp": 15,
    "perIp": 50,
    "perUser": 20
  },
  "session": {
    "maxAgeDays": 30,
    "idleTimeoutMinutes": 60,
    "sameSite": "strict",
    "secure": true,
    "cookieDomain": null,
    "refreshTokenRotation": true,
    "rememberMeMaxAgeDays": 90
  },
  "redirects": {
    "afterLogin": "/app",
    "afterLogout": "/auth/login",
    "firstLogin": "/welcome",
    "signupComplete": "/verify-email",
    "afterMfaEnroll": "/settings/security",
    "afterPasswordReset": "/auth/login?reset=success"
  }
}
