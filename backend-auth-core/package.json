{
  "name": "backend-auth-core",
  "version": "1.0.0",
  "description": "Backend auth core - Express + Prisma + TypeScript (ESM)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:studio": "prisma studio",
    "db:migrate": "dotenv -e .env.local --  prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local --  prisma migrate deploy",
    "db:migrate:baseline": "dotenv -e .env.local --  prisma migrate resolve --applied 20200101000000_baseline",
    "db:generate": "prisma generate",
    "db:backfill": "tsx scripts/backfill-auth-identity.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-test-users.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "tsx src/docs/generate-spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.4.2",
    "@types/nodemailer": "^6.4.23",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv-cli": "^11.0.0",
    "prisma": "5.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
