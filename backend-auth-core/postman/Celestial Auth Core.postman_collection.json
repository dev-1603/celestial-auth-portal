              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/email/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "email", "otp", "verify"]
            },
            "description": "Test with invalid OTP code - should return 401"
          },
          "response": []
        },
        {
          "name": "Verify OTP - Missing Fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/email/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "email", "otp", "verify"]
            },
            "description": "Test missing code - should return 400"
          },
          "response": []
        }
      ],
      "description": "Email OTP authentication endpoints"
    },
    {
      "name": "Magic Link Auth",
      "item": [
        {
          "name": "Send Magic Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.magicLink) {",
                  "        pm.environment.set('magicLinkUrl', jsonData.magicLink);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
