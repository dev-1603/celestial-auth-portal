            },
            "description": "Test with non-existent user - should return 404"
          },
          "response": []
        },
        {
          "name": "Verify Magic Link (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 302) {",
                  "    // Magic link verified",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/magic-link/verify?token={{magicLinkToken}}&email=user@example.com&redirect=http://localhost:3000/app",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "magic-link", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "{{magicLinkToken}}",
                  "description": "Token from magic link email"
                },
                {
                  "key": "email",
                  "value": "user@example.com"
                },
                {
                  "key": "redirect",
                  "value": "http://localhost:3000/app",
                  "description": "Optional redirect URL"
                }
              ]
            },
            "description": "Verify magic link via GET (browser click). Can redirect to frontend."
          },
          "response": []
        },
        {
          "name": "Verify Magic Link (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
