          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.expect(pm.response.code).to.be.oneOf([200, 401, 400]);",
                  "if (pm.response.code === 200) {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('accessToken');",
                  "    if (j.accessToken) pm.environment.set('accessToken', j.accessToken);",
                  "} else {",
                  "    pm.expect(pm.response.json()).to.satisfy((o) => o.error !== undefined || o.details !== undefined);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
