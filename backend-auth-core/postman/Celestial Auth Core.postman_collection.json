              "raw": "{{baseUrl}}/api/v1/auth/magic-link/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "magic-link", "send"]
            },
            "description": "Send magic link to email. In development, the link is returned in response."
