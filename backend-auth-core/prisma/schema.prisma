generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// CORE AUTH MODELS
// ─────────────────────────────────────────

model GlobalUser {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  memberships         TenantUserLink[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  appAccess           AppAccess[]
  passwordResets      PasswordReset[]
  invitations         Invitation[]         @relation("InvitedUser")
  authIdentities      AuthIdentity[]
  qrLoginSessions     QrLoginSession[]
  webAuthnCredentials WebAuthnCredential[]
}

model Tenant {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  domain      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships    TenantUserLink[]
  modules        TenantModule[]
  invitations    Invitation[]
  clientApps     ClientApp[]
  accessRequests AccessRequest[]
}

model TenantUserLink {
  id            String           @id @default(cuid())
  userId        String
  tenantId      String
  primary       Boolean          @default(false)
  isTenantOwner Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user      GlobalUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]
  modules   MembershipModule[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// ─────────────────────────────────────────
// ROLES & MODULES
// ─────────────────────────────────────────

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())

  memberships MembershipRole[]
}

model MembershipRole {
  id           String         @id @default(cuid())
  membershipId String
  roleId       String

  membership   TenantUserLink @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
}

model Module {
  id                String             @id @default(cuid())
  key               String             @unique
  name              String
  entryUrl          String
  type              ModuleType         @default(MFE)
  createdAt         DateTime           @default(now())

  tenantModules     TenantModule[]
  membershipModules MembershipModule[]
  appAccess         AppAccess[]
}

enum ModuleType {
  MFE
  EXTERNAL
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@index([tenantId])
}

model MembershipModule {
  id           String         @id @default(cuid())
  membershipId String
  moduleId     String
  enabled      Boolean        @default(true)

  membership   TenantUserLink @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  module       Module         @relation(fields: [moduleId], references: [id])

  @@unique([membershipId, moduleId])
}

// ─────────────────────────────────────────
// AUTH TOKENS & SESSIONS
// ─────────────────────────────────────────

model RefreshToken {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String
  clientId  String?
  expiresAt DateTime
  revoked   Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String     @id @default(cuid())
  userId       String
  clientId     String?
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user         GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// ACCESS REQUESTS (Waiting List)
// ─────────────────────────────────────────

model AccessRequest {
  id         String   @id @default(cuid())
  email      String
  name       String?
  reason     String?
  tenantId   String   // which tenant the user is requesting access to
  status     String   @default("pending") // pending | approved | rejected
  reviewedBy String?  // userId of the admin who reviewed
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([email, tenantId, status]) // one pending request per email per tenant
  @@index([tenantId, status])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// INVITATIONS
// ─────────────────────────────────────────

model Invitation {
  id         String     @id @default(cuid())
  email      String
  tenantId   String
  invitedBy  String?
  token      String     @unique
  expiresAt  DateTime
  accepted   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       GlobalUser? @relation("InvitedUser", fields: [invitedBy], references: [id])

  @@index([tenantId])
}

// ─────────────────────────────────────────
// AaaS — CLIENT APPS
// ─────────────────────────────────────────

model ClientApp {
  id            String      @id @default(cuid())
  tenantId      String
  name          String
  clientId      String      @unique
  clientSecret  String
  redirectUris  String[]
  createdAt     DateTime    @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authCodes     AuthCode[]
  appAccess     AppAccess[]

  @@index([tenantId])
}

model AppAccess {
  id       String     @id @default(cuid())
  userId   String
  clientId String
  moduleId String?

  user     GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   ClientApp  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  module   Module?    @relation(fields: [moduleId], references: [id])

  @@unique([userId, clientId])
}

model AuthCode {
  id          String    @id @default(cuid())
  code        String    @unique
  clientId    String
  userId      String
  redirectUri String
  expiresAt   DateTime
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  client      ClientApp @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ─────────────────────────────────────────
// MULTI-METHOD AUTH MODELS
// ─────────────────────────────────────────

enum AuthMethodType {
  PASSWORD   // email/password
  OAUTH      // google, github, etc.
  SSO        // enterprise SSO (SAML, OIDC)
  MAGIC_LINK // email magic link
  OTP        // email OTP, SMS OTP
  PHONE      // phone number auth
  QR_LOGIN   // QR code-based login
  PASSKEY    // WebAuthn/FIDO2 passkey
}

model AuthIdentity {
  id             String         @id @default(cuid())
  userId         String
  providerType   String         // e.g. "email", "google", "github", "magic_link", "phone"
  providerUserId String         // e.g. Google sub, or email for providerType=email, or phone E.164
  authMethodType AuthMethodType? // category: PASSWORD | OAUTH | MAGIC_LINK | OTP | PHONE
  email          String?       // optional; from provider or for email identity
  displayName    String?
  metadata       Json?          // provider-specific claims
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           GlobalUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerType, providerUserId])
  @@index([userId])
  @@index([authMethodType])
}

model VerificationCode {
  id         String   @id @default(cuid())
  channel    String   // "email" | "phone"
  target     String   // email address or E.164 phone
  codeHash   String   // hashed OTP or token
  purpose    String   // "login" | "signup" | "mfa" | "magic_link"
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  userId    String?  // set when claimed (e.g. magic link used)
  createdAt  DateTime @default(now())

  @@index([channel, target, purpose])
  @@index([expiresAt])
}

// ─────────────────────────────────────────
// QR LOGIN SESSIONS
// ─────────────────────────────────────────

model QrLoginSession {
  id           String      @id @default(cuid())
  sessionToken String      @unique
  status       String      @default("pending") // pending | scanned | confirmed | expired
  userId       String?     // set when an authenticated user confirms the QR login
  qrData       String?     // payload encoded in the QR code (URL or token)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         GlobalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionToken])
  @@index([expiresAt])
}

// ─────────────────────────────────────────
// WEBAUTHN / PASSKEY CREDENTIALS
// ─────────────────────────────────────────

model WebAuthnCredential {
  id           String     @id @default(cuid())
  userId       String
  credentialId String     @unique   // base64url-encoded credential ID from authenticator
  publicKey    Bytes                // COSE public key bytes
  counter      BigInt     @default(0) // signature counter for clone detection
  transports   String[]   @default([]) // e.g. ["usb", "ble", "nfc", "internal"]
  deviceType   String?    // "singleDevice" | "multiDevice"
  backedUp     Boolean    @default(false)
  friendlyName String?    // user-assigned label for the credential
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
