generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// CORE AUTH MODELS
// ─────────────────────────────────────────

model GlobalUser {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  memberships   TenantUserLink[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  appAccess     AppAccess[]
  passwordResets PasswordReset[]
  invitations   Invitation[]   @relation("InvitedUser")
}

model Tenant {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  domain      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships TenantUserLink[]
  modules     TenantModule[]
  invitations Invitation[]
  clientApps  ClientApp[]
}

model TenantUserLink {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  primary   Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      GlobalUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]
  modules   MembershipModule[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// ─────────────────────────────────────────
// ROLES & MODULES
// ─────────────────────────────────────────

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())

  memberships MembershipRole[]
}

model MembershipRole {
  id           String         @id @default(cuid())
  membershipId String
  roleId       String

  membership   TenantUserLink @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
}

model Module {
  id                String             @id @default(cuid())
  key               String             @unique
  name              String
  entryUrl          String
  type              ModuleType         @default(MFE)
  createdAt         DateTime           @default(now())

  tenantModules     TenantModule[]
  membershipModules MembershipModule[]
  appAccess         AppAccess[]
}

enum ModuleType {
  MFE
  EXTERNAL
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@index([tenantId])
}

model MembershipModule {
  id           String         @id @default(cuid())
  membershipId String
  moduleId     String
  enabled      Boolean        @default(true)

  membership   TenantUserLink @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  module       Module         @relation(fields: [moduleId], references: [id])

  @@unique([membershipId, moduleId])
}

// ─────────────────────────────────────────
// AUTH TOKENS & SESSIONS
// ─────────────────────────────────────────

model RefreshToken {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String
  clientId  String?
  expiresAt DateTime
  revoked   Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String     @id @default(cuid())
  userId       String
  clientId     String?
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user         GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// INVITATIONS
// ─────────────────────────────────────────

model Invitation {
  id         String     @id @default(cuid())
  email      String
  tenantId   String
  invitedBy  String?
  token      String     @unique
  expiresAt  DateTime
  accepted   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       GlobalUser? @relation("InvitedUser", fields: [invitedBy], references: [id])

  @@index([tenantId])
}

// ─────────────────────────────────────────
// AaaS — CLIENT APPS
// ─────────────────────────────────────────

model ClientApp {
  id            String      @id @default(cuid())
  tenantId      String
  name          String
  clientId      String      @unique
  clientSecret  String
  redirectUris  String[]
  createdAt     DateTime    @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authCodes     AuthCode[]
  appAccess     AppAccess[]

  @@index([tenantId])
}

model AppAccess {
  id       String     @id @default(cuid())
  userId   String
  clientId String
  moduleId String?

  user     GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   ClientApp  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  module   Module?    @relation(fields: [moduleId], references: [id])

  @@unique([userId, clientId])
}

model AuthCode {
  id          String    @id @default(cuid())
  code        String    @unique
  clientId    String
  userId      String
  redirectUri String
  expiresAt   DateTime
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  client      ClientApp @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}
