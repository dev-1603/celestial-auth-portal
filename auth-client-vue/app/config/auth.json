    "rateLimits": {
        "loginAttempts": 5,
        "windowMinutesLogin": 15,
        "resetRequests": 3,
        "windowMinutesReset": 60,
        "otpRequests": 5,
        "windowMinutesOtp": 15,
        "perIp": 50,
        "perUser": 20
    },
    "session": {
        "maxAgeDays": 30,
        "idleTimeoutMinutes": 60,
        "sameSite": "strict",
        "secure": true,
        "cookieDomain": null,
        "refreshTokenRotation": true,
        "rememberMeMaxAgeDays": 90
    },
    "redirects": {
        "afterLogin": "/app",
        "afterLogout": "/auth/login",
        "firstLogin": "/welcome",
        "signupComplete": "/verify-email",
        "afterMfaEnroll": "/settings/security",
        "afterPasswordReset": "/auth/login?reset=success"
    },
    "security": {
        "requestHeaders": [
            {
                "name": "X-Request-ID",
                "source": "generate-uuid"
            },
            {
                "name": "X-Client-Version",
                "value": "1.0",
                "source": "static"
            }
        ]
    }
}