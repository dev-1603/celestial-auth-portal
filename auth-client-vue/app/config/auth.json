{
    "methodIcons": {
        "email_password": "lucide:mail",
        "email_otp": "lucide:message-square",
        "magic_link": "lucide:link",
        "phone_sms_otp": "lucide:smartphone",
        "oauth": "lucide:globe",
        "sso": "lucide:shield-check",
        "qr_login": "lucide:qr-code",
        "telegram": "simple-icons:telegram",
        "whatsapp": "simple-icons:whatsapp",
        "passkey": "lucide:fingerprint"
    },
    "enabledMethods": [
        "email_password",
        "email_otp",
        "magic_link",
        "phone_sms_otp",
        "oauth",
        "sso",
        "qr_login",
        "telegram",
        "whatsapp",
        "passkey"
    ],
    "defaultMethod": "email_password",
    "signupMode": "invite_only",
    "passwordPolicy": {
        "minLength": 2,
        "requireUpper": true,
        "requireLower": true,
        "requireNumber": true,
        "requireSpecial": true,
        "allowCommon": false,
        "maxAgeDays": 90,
        "historyCount": 5,
        "lockoutThreshold": 5,
        "lockoutMinutes": 15
    },
    "emailVerification": true,
    "requireVerifiedEmail": true,
    "mfa": {
        "required": false,
        "policy": "optional",
        "methods": [
            "totp",
            "sms",
            "webauthn"
        ]
    },
    "methodsConfig": {
        "email_password": {
            "enabled": true,
            "allowSignup": true
        },
        "email_otp": {
            "enabled": true,
            "digits": 6,
            "expiryMinutes": 10,
            "maxAttempts": 5
        },
        "magic_link": {
            "enabled": true,
            "expiryMinutes": 20,
            "allowedDomains": []
        },
        "phone_sms_otp": {
            "enabled": true,
            "digits": 6,
            "expiryMinutes": 10,
            "maxAttempts": 5,
            "provider": "twilio",
            "fromNumber": "+19999999999"
        },
        "qr_login": {
            "enabled": true,
            "sessionExpirySeconds": 120
        },
        "telegram": {
            "enabled": true,
            "botName": ""
        },
        "whatsapp": {
            "enabled": true,
            "provider": "whatsauth"
        },
        "passkey": {
            "enabled": true,
            "userVerification": "preferred"
        }
    },
    "ui": {
        "providerIconOnly": true
    },
    "providers": {
