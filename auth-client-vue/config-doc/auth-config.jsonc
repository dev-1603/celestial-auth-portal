{
    "tenantId": "default",
    "auth": {
        // =========================
        // CORE FLAGS
        // =========================
        "enabledMethods": [
            "email_password", // PH1
            "email_otp", // PH1
            "magic_link", // PH1
            "phone_sms_otp", // PH1
            "oauth", // PH1
            "sso", // PH1
            "qr_login", // PH2
            "telegram", // PH3
            "whatsapp", // PH3
            "passkey" // PH3
        ],
        "defaultMethod": "email_password",
        "signupMode": "invite_only", // "open" | "invite_only" | "closed"
        // =========================
        // PASSWORD & VERIFICATION
        // =========================
        "passwordPolicy": {
            "minLength": 12,
            "requireUpper": true,
            "requireLower": true,
            "requireNumber": true,
            "requireSpecial": true,
            "allowCommon": false,
            "maxAgeDays": 90,
            "historyCount": 5,
            "lockoutThreshold": 5,
            "lockoutMinutes": 15
        },
        "emailVerification": true,
        "requireVerifiedEmail": true,
        // =========================
        // MFA
        // =========================
        "mfa": {
            "required": false,
            "policy": "optional", // "off" | "optional" | "required"
            "methods": [
                "totp",
                "sms",
                "webauthn"
            ]
        },
        // =========================
        // PER-METHOD CONFIG
        // =========================
        "methodsConfig": {
            "email_password": {
                "enabled": true,
                "allowSignup": true
            },
            "email_otp": {
                "enabled": true,
                "digits": 6,
                "expiryMinutes": 10,
                "maxAttempts": 5
            },
            "magic_link": {
                "enabled": true,
                "expiryMinutes": 20,
                "allowedDomains": []
            },
            "phone_sms_otp": {
                "enabled": true,
                "digits": 6,
                "expiryMinutes": 10,
                "maxAttempts": 5,
                "provider": "twilio",
                "fromNumber": "+19999999999"
            },
            "qr_login": {
                "enabled": true,
                "sessionExpirySeconds": 120
            },
            "telegram": {
                "enabled": false,
                "botName": ""
            },
            "whatsapp": {
                "enabled": false,
                "provider": "whatsauth"
            },
            "passkey": {
                "enabled": false,
                "userVerification": "preferred"
            }
        },
        // =========================
        // PROVIDERS (SOCIAL + SSO)
        // =========================
        "providers": {
            "oauth": [
                // CORE SOCIAL (PHASE 1)
                {
                    "id": "google",
                    "enabled": true,
                    "displayName": "Google",
                    "logo": "/icons/oauth/google.svg",
                    "buttonVariant": "primary"
                },
                {
                    "id": "github",
                    "enabled": true,
                    "displayName": "GitHub",
                    "logo": "/icons/oauth/github.svg",
                    "buttonVariant": "outline"
                },
                {
                    "id": "microsoft",
                    "enabled": true,
                    "displayName": "Microsoft",
                    "logo": "/icons/oauth/microsoft.svg",
                    "buttonVariant": "outline"
                },
                // ADDITIONAL OAUTH / B2C (PHASE 2+)
                {
                    "id": "apple",
                    "enabled": false,
