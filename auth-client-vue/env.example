# Auth API (auth-core backend or BFF). Used to build full API URLs (see config/apiRoutes.json).
NUXT_PUBLIC_AUTH_API_URL=http://localhost:5001

APP_MODE – "single" | "multi" | "multi-tenant"

APP_BASE_URL – base URL of the auth portal

DATABASE_URL – only used in modes that hit DB (multi-tenant, or multi-client if you choose)
TENANT_SLUG = # multiclient build
TENANT_CONFIG_API = ## multiclient build

# Multi-tenant runtime:
TENANT_RESOLUTION_STRATEGY=
 TENANT_CONFIG_CACHE_TTL=
  DEFAULT_PLAN=

