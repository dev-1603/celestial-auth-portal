#!/usr/bin/env bash
#
# Example environment variables for auth-client-vue (Nuxt BFF).
# Copy to .env:  cp env.example .env

# --- Required for local dev / OAuth ---

# Auth API (backend-auth-core). Must match backend PORT.
NUXT_PUBLIC_AUTH_API_URL=http://localhost:5001

# Base URL of this auth portal (used for OAuth redirect URIs in provider dashboards).
# Use the URL you open in the browser (e.g. http://localhost:3000).
APP_BASE_URL=http://localhost:3000

# Required for OAuth handshake cookie. MUST be at least 16 characters.
# Use a random string in production; this example works for local testing.
AUTH_HANDSHAKE_SECRET=local-dev-handshake-secret-32ch

# --- Optional: deployment / tenancy ---

# single | multi | multi-tenant
APP_MODE=single

# Only needed in modes that use a DB from this app.
DATABASE_URL=
TENANT_SLUG=
TENANT_CONFIG_API=
TENANT_RESOLUTION_STRATEGY=
TENANT_CONFIG_CACHE_TTL=
DEFAULT_PLAN=

